@if (TotalPaginas > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-center flex-wrap mb-0">
            <li class="page-item @(PaginaActual == 1 ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(PaginaActual == 1)"
                        aria-label="Página anterior" @onclick="() => IrAAsync(PaginaActual - 1)">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            </li>

            @for (int numero = Desde; numero <= Hasta; numero++)
            {
                int pagina = numero;
                <li class="page-item @(pagina == PaginaActual ? "active" : "")">
                    <button type="button" class="page-link"
                            aria-current="@(pagina == PaginaActual ? "page" : null)"
                            @onclick="() => IrAAsync(pagina)">
                        @pagina
                    </button>
                </li>
            }

            <li class="page-item @(PaginaActual == TotalPaginas ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(PaginaActual == TotalPaginas)"
                        aria-label="Página siguiente" @onclick="() => IrAAsync(PaginaActual + 1)">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </li>
        </ul>
    </nav>
}

@code {
    /// <summary>Página que se está viendo (empieza en 1).</summary>
    [Parameter] public int PaginaActual { get; set; } = 1;

    /// <summary>Cantidad total de páginas.</summary>
    [Parameter] public int TotalPaginas { get; set; }

    /// <summary>Se dispara con el número de página elegido.</summary>
    [Parameter] public EventCallback<int> OnCambio { get; set; }

    private int Desde => Math.Max(1, PaginaActual - 2);

    private int Hasta => Math.Min(TotalPaginas, PaginaActual + 2);

    private async Task IrAAsync(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas || pagina == PaginaActual)
        {
            return;
        }

        await OnCambio.InvokeAsync(pagina);
    }
}