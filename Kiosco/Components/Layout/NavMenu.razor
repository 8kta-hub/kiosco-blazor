@implements IDisposable
@inject CarritoState Carrito

<nav class="menu" aria-label="Navegación principal">
    <NavLink href="" Match="NavLinkMatch.All">
        <i class="bi bi-house-door" aria-hidden="true"></i> Inicio
    </NavLink>
    <NavLink href="productos">
        <i class="bi bi-box-seam" aria-hidden="true"></i> Productos
    </NavLink>
    <NavLink href="stock">
        <i class="bi bi-boxes" aria-hidden="true"></i> Stock
    </NavLink>
    <NavLink href="caja">
        <i class="bi bi-cash-coin" aria-hidden="true"></i> Caja
    </NavLink>
    <NavLink href="vender">
        <i class="bi bi-cart3" aria-hidden="true"></i> Vender
        @if (Carrito.CantidadUnidades > 0)
        {
            <span class="badge text-bg-danger rounded-pill">@Carrito.CantidadUnidades</span>
            <span class="visually-hidden">unidades en el carrito</span>
        }
    </NavLink>
    <NavLink href="ventas">
        <i class="bi bi-receipt" aria-hidden="true"></i> Ventas
    </NavLink>
</nav>

@code {
    protected override void OnInitialized()
    {
        Carrito.OnChange += AlCambiarElCarrito;
    }

    private void AlCambiarElCarrito()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Carrito.OnChange -= AlCambiarElCarrito;
    }
}